<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="CalculadoraBasicaA.App">
  <Application.Resources><ResourceDictionary>
    <Color x:Key="Primary">#235CF2</Color>
    <Color x:Key="TextColor">#152445</Color>
    <Color x:Key="Muted">#53627D</Color>
    <Color x:Key="Soft">#EAF0FF</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Style TargetType="ContentPage"><Setter Property="BackgroundColor" Value="#F5F7FC" /></Style>
    <Style TargetType="Label"><Setter Property="TextColor" Value="#152445" /><Setter Property="FontSize" Value="16" /><Setter Property="LineBreakMode" Value="WordWrap" /></Style>
    <Style TargetType="Entry"><Setter Property="BackgroundColor" Value="#FFFFFF" /><Setter Property="TextColor" Value="#152445" /><Setter Property="PlaceholderColor" Value="#53627D" /><Setter Property="MinimumHeightRequest" Value="52" /><Setter Property="FontSize" Value="18" /></Style>
    <Style TargetType="Button"><Setter Property="BackgroundColor" Value="#235CF2" /><Setter Property="TextColor" Value="#FFFFFF" /><Setter Property="CornerRadius" Value="10" /><Setter Property="MinimumHeightRequest" Value="50" /><Setter Property="FontSize" Value="16" /><Setter Property="FontAttributes" Value="Bold" /></Style>
    <Style x:Key="Secondary" TargetType="Button"><Setter Property="BackgroundColor" Value="#EAF0FF" /><Setter Property="TextColor" Value="#152445" /><Setter Property="CornerRadius" Value="10" /><Setter Property="MinimumHeightRequest" Value="50" /><Setter Property="FontSize" Value="15" /></Style>
    <Style TargetType="Border"><Setter Property="BackgroundColor" Value="#FFFFFF" /><Setter Property="Stroke" Value="#DCE3F0" /><Setter Property="StrokeShape" Value="RoundRectangle 14" /><Setter Property="Padding" Value="20" /></Style>
  </ResourceDictionary></Application.Resources>
</Application>
