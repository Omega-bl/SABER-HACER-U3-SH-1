<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="CalculadoraMejoradaA.MainPage">
  <ScrollView><VerticalStackLayout Padding="24,30" Spacing="18" MaximumWidthRequest="560" HorizontalOptions="Fill">
    <Label Text="04 / MÁS OPERACIONES" FontSize="12" FontAttributes="Bold" TextColor="#235CF2" />
    <Label Text="Calculadora +" FontSize="30" FontAttributes="Bold" />
    <VerticalStackLayout Spacing="10"><Label Text="Primer número" FontAttributes="Bold" />
        <Entry x:Name="FirstNumberEntry" Placeholder="Ejemplo: 8" Keyboard="Numeric" MaxLength="40" SemanticProperties.Description="Primer número" Focused="OnNumeroFocused" /><Label Text="Segundo número" FontAttributes="Bold" />
        <Entry x:Name="SecondNumberEntry" Placeholder="Ejemplo: 4" Keyboard="Numeric" MaxLength="40" SemanticProperties.Description="Segundo número" Focused="OnNumeroFocused" /></VerticalStackLayout><Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto" ColumnSpacing="10" RowSpacing="10"><Button Grid.Row="0" Grid.Column="0" Text="+" CommandParameter="+" Clicked="OnOperationClicked" FontSize="26" SemanticProperties.Description="Sumar" /><Button Grid.Row="0" Grid.Column="1" Text="−" CommandParameter="-" Clicked="OnOperationClicked" FontSize="26" SemanticProperties.Description="Restar" /><Button Grid.Row="0" Grid.Column="2" Text="×" CommandParameter="*" Clicked="OnOperationClicked" FontSize="26" SemanticProperties.Description="Multiplicar" /><Button Grid.Row="0" Grid.Column="3" Text="÷" CommandParameter="/" Clicked="OnOperationClicked" FontSize="26" SemanticProperties.Description="Dividir" /></Grid><Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10"><Button Grid.Row="0" Grid.Column="0" Text="x²" CommandParameter="cuadrado" Clicked="OnOperationClicked" Style="{StaticResource Secondary}" SemanticProperties.Description="Cuadrado del primer número" /><Button Grid.Row="0" Grid.Column="1" Text="√x" CommandParameter="raiz" Clicked="OnOperationClicked" Style="{StaticResource Secondary}" SemanticProperties.Description="Raíz del primer número" /><Button Grid.Row="0" Grid.Column="2" Text="xʸ" CommandParameter="potencia" Clicked="OnOperationClicked" Style="{StaticResource Secondary}" SemanticProperties.Description="Primer número elevado al segundo" /><Button Grid.Row="1" Grid.Column="0" Text="%" CommandParameter="porcentaje" Clicked="OnOperationClicked" Style="{StaticResource Secondary}" SemanticProperties.Description="Porcentaje del primer número indicado por el segundo" /><Button Grid.Row="1" Grid.Column="1" Text="1/x" CommandParameter="inversa" Clicked="OnOperationClicked" Style="{StaticResource Secondary}" SemanticProperties.Description="Inversa del primer número" /><Button Grid.Row="1" Grid.Column="2" Text="mod" CommandParameter="resto" Clicked="OnOperationClicked" Style="{StaticResource Secondary}" SemanticProperties.Description="Resto de la división" /></Grid><Label Text="Toca un campo para editarlo. A/B cambia de campo; % calcula el segundo número por ciento del primero." TextColor="{StaticResource Muted}" FontSize="13" /><Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8"><Button Grid.Row="0" Grid.Column="0" Text="7" CommandParameter="7" Clicked="OnTeclaClicked" Style="{StaticResource Secondary}" FontSize="21" /><Button Grid.Row="0" Grid.Column="1" Text="8" CommandParameter="8" Clicked="OnTeclaClicked" Style="{StaticResource Secondary}" FontSize="21" /><Button Grid.Row="0" Grid.Column="2" Text="9" CommandParameter="9" Clicked="OnTeclaClicked" Style="{StaticResource Secondary}" FontSize="21" /><Button Grid.Row="0" Grid.Column="3" Text="⌫" CommandParameter="⌫" Clicked="OnTeclaClicked" Style="{StaticResource Secondary}" FontSize="21" /><Button Grid.Row="1" Grid.Column="0" Text="4" CommandParameter="4" Clicked="OnTeclaClicked" Style="{StaticResource Secondary}" FontSize="21" /><Button Grid.Row="1" Grid.Column="1" Text="5" CommandParameter="5" Clicked="OnTeclaClicked" Style="{StaticResource Secondary}" FontSize="21" /><Button Grid.Row="1" Grid.Column="2" Text="6" CommandParameter="6" Clicked="OnTeclaClicked" Style="{StaticResource Secondary}" FontSize="21" /><Button Grid.Row="1" Grid.Column="3" Text="±" CommandParameter="±" Clicked="OnTeclaClicked" Style="{StaticResource Secondary}" FontSize="21" /><Button Grid.Row="2" Grid.Column="0" Text="1" CommandParameter="1" Clicked="OnTeclaClicked" Style="{StaticResource Secondary}" FontSize="21" /><Button Grid.Row="2" Grid.Column="1" Text="2" CommandParameter="2" Clicked="OnTeclaClicked" Style="{StaticResource Secondary}" FontSize="21" /><Button Grid.Row="2" Grid.Column="2" Text="3" CommandParameter="3" Clicked="OnTeclaClicked" Style="{StaticResource Secondary}" FontSize="21" /><Button Grid.Row="2" Grid.Column="3" Text="C" CommandParameter="C" Clicked="OnTeclaClicked" Style="{StaticResource Secondary}" FontSize="21" /><Button Grid.Row="3" Grid.Column="0" Text="0" CommandParameter="0" Clicked="OnTeclaClicked" Style="{StaticResource Secondary}" FontSize="21" /><Button Grid.Row="3" Grid.Column="1" Text="." CommandParameter="." Clicked="OnTeclaClicked" Style="{StaticResource Secondary}" FontSize="21" /><Button Grid.Row="3" Grid.Column="2" Text="A/B" CommandParameter="A/B" Clicked="OnTeclaClicked" Style="{StaticResource Secondary}" FontSize="21" /><Button Grid.Row="3" Grid.Column="3" Text="=" CommandParameter="=" Clicked="OnTeclaClicked" Style="{StaticResource Secondary}" FontSize="21" /></Grid><Border BackgroundColor="{StaticResource Soft}"><Label x:Name="ResultLabel" Text="Resultado:" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" /></Border>
    <Button Text="Limpiar" Clicked="OnClearClicked" Style="{StaticResource Secondary}" />
  </VerticalStackLayout></ScrollView>
</ContentPage>
